# HTTP
PORT=4000
CORS_ORIGIN=*

# Window
CALENDAR_PAST_DAYS=2
CALENDAR_FUTURE_DAYS=7

# Base refresh loop
CALENDAR_REFRESH_INTERVAL_MS=300000
CALENDAR_REFRESH_ON_BOOT=true

# Release watcher (burst polling around each scheduled print)
CALENDAR_WATCH_ENABLED=true
CALENDAR_WATCH_LEAD_MS=2000
CALENDAR_WATCH_POLL_INTERVAL_MS=10000
CALENDAR_WATCH_MAX_DURATION_MS=600000
CALENDAR_WATCH_MIN_IMPACT=low
CALENDAR_WATCH_HORIZON_MS=93600000

# Scraper. Chromium must run headed (use xvfb-run) to clear Cloudflare.
SCRAPER_HEADLESS=false
# SCRAPER_CHROMIUM_PATH=/opt/pw-browsers/chromium
SCRAPER_NAVIGATION_TIMEOUT_MS=90000
SCRAPER_IDLE_SHUTDOWN_MS=900000
SCRAPER_RETRIES=2

# JSON fallback
CALENDAR_FEED_ENABLED=true

# Per-source bounds
CALENDAR_SOURCE_TIMEOUT_MS=60000
CALENDAR_SOURCE_BREAKER_THRESHOLD=3
CALENDAR_SOURCE_BREAKER_COOLDOWN_MS=300000

# Warm start
CALENDAR_SNAPSHOT_ENABLED=true
CALENDAR_SNAPSHOT_PATH=data/calendar-snapshot.json

# ---------------------------------------------------------------- derivatives
# Coins the CoinGlass scraper keeps a full breakdown for.
DERIVATIVES_ASSETS=BTC,ETH,SOL
DERIVATIVES_REFRESH_INTERVAL_MS=60000
DERIVATIVES_REFRESH_ON_BOOT=true
DERIVATIVES_SOURCE_TIMEOUT_MS=180000

# CoinGlass needs no Cloudflare clearance, so headless is fine.
COINGLASS_URL=https://www.coinglass.com
COINGLASS_HEADLESS=true
# COINGLASS_CHROMIUM_PATH=/path/to/chrome
COINGLASS_NAVIGATION_TIMEOUT_MS=90000
# How long to let each page keep answering, and the quiet gap that ends it early.
COINGLASS_SETTLE_MS=12000
COINGLASS_SETTLE_QUIET_MS=2500
COINGLASS_IDLE_SHUTDOWN_MS=600000
COINGLASS_USER_DATA_DIR=.browser-profile-coinglass
COINGLASS_RETRIES=1
# Caps on the firehose endpoints.
COINGLASS_MAX_ORDERS=60
COINGLASS_MAX_SCREENER_ROWS=100
COINGLASS_MAX_SERIES_POINTS=240

DERIVATIVES_SNAPSHOT_ENABLED=true
DERIVATIVES_SNAPSHOT_PATH=data/derivatives-snapshot.json
DERIVATIVES_SNAPSHOT_SEED_PATH=seed/derivatives-snapshot.json

# -------------------------------------------------------------------- archive
# Postgres, via Prisma. Leave unset to run without history: the scrapers, the
# live window and the file snapshot all work without it.
DATABASE_URL=postgresql://marketpulse:marketpulse@127.0.0.1:5432/marketpulse?schema=public

DERIVATIVES_ARCHIVE_ENABLED=true
# How often to store the series that have no natural key (coin totals, venue
# table, market snapshot). The scrape itself still runs every minute.
DERIVATIVES_HISTORY_INTERVAL_MS=300000
# Drop sampled rows older than this; 0 keeps everything.
DERIVATIVES_ARCHIVE_RETENTION_DAYS=90

# Liquidation heatmap ("liquidity map"). BTC is all CoinGlass serves on the
# open site; the grid is what the raw ~15k cells are summed down to.
COINGLASS_HEATMAP_ENABLED=true
COINGLASS_HEATMAP_SYMBOLS=BTC
COINGLASS_HEATMAP_COLUMNS=60
COINGLASS_HEATMAP_LEVELS=40

# ---------------------------------------------------------------- ai & agents
# Everything below is optional. With none of it set the service still boots:
# the agent endpoints answer, and the panel reports that no model is configured
# until a provider is given a key in Settings → AI & Agents.

# Sealing key for stored provider secrets (AES-256-GCM). 32 bytes, hex or
# base64. Generate with: openssl rand -hex 32
# Leave unset and one is generated on first boot and written to
# AGENT_SECRET_KEY_PATH; set it explicitly for anything multi-instance, or the
# instances cannot read each other's secrets.
# AGENT_SECRET_KEY=
AGENT_SECRET_KEY_PATH=data/agent-secret.key
AGENT_SECRET_STORE_PATH=data/agent-secrets.json

# Shared secret a client must present to register a device and be issued a
# token. Unset means any client on the network may register — fine for a local
# machine, not for anything exposed. A client build passes it back through
# EXPO_PUBLIC_AGENT_REGISTRATION_SECRET.
# AGENT_REGISTRATION_SECRET=

# File backings, used only when DATABASE_URL is unset. With a database the
# conversations, messages, references, session items and runs live in Postgres.
AGENT_STORE_PATH=data/agent-conversations.json
AI_SETTINGS_PATH=data/ai-settings.json

# OpenAI's tracing exporter. Off unless this is exactly "on", because it ships
# run metadata off the machine.
AGENT_TRACING=off
# AGENT_TRACING_API_KEY=

# Optional provider seeds. A key here pre-configures that provider at boot;
# a key entered in Settings takes precedence and is sealed at rest.
# OPENAI_API_KEY=
# OPENAI_DEFAULT_MODEL=gpt-4.1-mini
# OPENAI_SEARCH_MODEL=gpt-4.1-mini
# OPENROUTER_API_KEY=
# OPENROUTER_DEFAULT_MODEL=openai/gpt-4.1-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
# GOOGLE_API_KEY=
# GOOGLE_DEFAULT_MODEL=gemini-2.5-flash

# ----------------------------------------------------------------------- news
# Calendar releases become news items on their own; these are the extra feeds.
# Comma-separated. Each entry is either a URL or publisher|URL.
# NEWS_RSS_FEEDS=Federal Reserve|https://www.federalreserve.gov/feeds/press_all.xml
NEWS_RSS_TIMEOUT_MS=20000
NEWS_REFRESH_INTERVAL_MS=300000
NEWS_REFRESH_ON_BOOT=true
NEWS_STORE_PATH=data/news-store.json
