# HTTP
PORT=4000
CORS_ORIGIN=*

# Window
CALENDAR_PAST_DAYS=2
CALENDAR_FUTURE_DAYS=7

# Base refresh loop
CALENDAR_REFRESH_INTERVAL_MS=300000
CALENDAR_REFRESH_ON_BOOT=true

# Release watcher (burst polling around each scheduled print)
CALENDAR_WATCH_ENABLED=true
CALENDAR_WATCH_LEAD_MS=2000
CALENDAR_WATCH_POLL_INTERVAL_MS=10000
CALENDAR_WATCH_MAX_DURATION_MS=600000
CALENDAR_WATCH_MIN_IMPACT=low
CALENDAR_WATCH_HORIZON_MS=93600000

# Scraper. Chromium must run headed (use xvfb-run) to clear Cloudflare.
SCRAPER_HEADLESS=false
# SCRAPER_CHROMIUM_PATH=/opt/pw-browsers/chromium
SCRAPER_NAVIGATION_TIMEOUT_MS=90000
SCRAPER_IDLE_SHUTDOWN_MS=900000
SCRAPER_RETRIES=2

# JSON fallback
CALENDAR_FEED_ENABLED=true

# Per-source bounds
CALENDAR_SOURCE_TIMEOUT_MS=60000
CALENDAR_SOURCE_BREAKER_THRESHOLD=3
CALENDAR_SOURCE_BREAKER_COOLDOWN_MS=300000

# Warm start
CALENDAR_SNAPSHOT_ENABLED=true
CALENDAR_SNAPSHOT_PATH=data/calendar-snapshot.json

# ---------------------------------------------------------------- derivatives
# Coins the CoinGlass scraper keeps a full breakdown for.
DERIVATIVES_ASSETS=BTC,ETH,SOL
DERIVATIVES_REFRESH_INTERVAL_MS=60000
DERIVATIVES_REFRESH_ON_BOOT=true
DERIVATIVES_SOURCE_TIMEOUT_MS=180000

# CoinGlass needs no Cloudflare clearance, so headless is fine.
COINGLASS_URL=https://www.coinglass.com
COINGLASS_HEADLESS=true
# COINGLASS_CHROMIUM_PATH=/path/to/chrome
COINGLASS_NAVIGATION_TIMEOUT_MS=90000
# How long to let each page keep answering, and the quiet gap that ends it early.
COINGLASS_SETTLE_MS=12000
COINGLASS_SETTLE_QUIET_MS=2500
COINGLASS_IDLE_SHUTDOWN_MS=600000
COINGLASS_USER_DATA_DIR=.browser-profile-coinglass
COINGLASS_RETRIES=1
# Caps on the firehose endpoints.
COINGLASS_MAX_ORDERS=60
COINGLASS_MAX_SCREENER_ROWS=100
COINGLASS_MAX_SERIES_POINTS=240

DERIVATIVES_SNAPSHOT_ENABLED=true
DERIVATIVES_SNAPSHOT_PATH=data/derivatives-snapshot.json
DERIVATIVES_SNAPSHOT_SEED_PATH=seed/derivatives-snapshot.json
