// The archive.
//
// The scrapers hold a live window in memory — a few days of calendar, the
// latest derivatives snapshot — because that is what the app reads on every
// poll. This is where the rest of it goes: everything that has already
// happened, kept so a number that printed last week is still answerable
// without scraping for it again.
//
// Two rules shape the tables below:
//
//  1. Writes are incremental. Rows already stored are never rewritten, and a
//     sync that saw nothing new writes nothing at all.
//  2. Every time series is keyed by its natural identity — an event id, a
//     (symbol, timestamp) pair, a liquidation's own fingerprint — so a repeated
//     scrape of overlapping data collapses into the rows already there instead
//     of duplicating them.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// One economic release, carried forward after it leaves the live window.
model CalendarEvent {
  /// Deterministic across sources and refreshes: title + currency + day.
  id            String    @id
  sourceId      Int?      @map("source_id")
  title         String
  currency      String
  country       String
  impact        String
  scheduledAt   DateTime  @map("scheduled_at")
  timePrecision String    @map("time_precision")
  actual        String?
  forecast      String?
  previous      String?
  revision      String?
  outcome       String
  released      Boolean
  leaked        Boolean
  source        String
  detailUrl     String?   @map("detail_url")
  /// When this row was first written, as opposed to when it last changed.
  firstSeenAt   DateTime  @default(now()) @map("first_seen_at")
  updatedAt     DateTime  @map("updated_at")
  /// The moment an `actual` first appeared — the print itself, not a re-read.
  releasedAt    DateTime? @map("released_at")

  @@index([scheduledAt])
  @@index([currency, scheduledAt])
  @@index([impact, scheduledAt])
  @@map("calendar_event")
}

/// A coin's derivatives market at one moment, as the scraper saw it.
model AssetSnapshot {
  id                      Int      @id @default(autoincrement())
  symbol                  String
  capturedAt              DateTime @map("captured_at")
  price                   Float?
  priceChangePercent24h   Float?   @map("price_change_percent_24h")
  marketCap               Float?   @map("market_cap")
  openInterestUsd         Float?   @map("open_interest_usd")
  openInterestAmount      Float?   @map("open_interest_amount")
  openInterestChange24h   Float?   @map("open_interest_change_24h")
  volumeUsd24h            Float?   @map("volume_usd_24h")
  volumeChange24h         Float?   @map("volume_change_24h")
  oiVolumeRatio           Float?   @map("oi_volume_ratio")
  fundingByOpenInterest   Float?   @map("funding_by_open_interest")
  fundingByVolume         Float?   @map("funding_by_volume")
  fundingAnnualized       Float?   @map("funding_annualized")
  longShortRatio24h       Float?   @map("long_short_ratio_24h")
  globalAccountRatio      Float?   @map("global_account_ratio")
  topAccountRatio         Float?   @map("top_account_ratio")
  topPositionRatio        Float?   @map("top_position_ratio")
  optionsOpenInterestUsd  Float?   @map("options_open_interest_usd")
  optionsVolumeUsd24h     Float?   @map("options_volume_usd_24h")
  liquidationUsd24h       Float?   @map("liquidation_usd_24h")
  longLiquidationUsd24h   Float?   @map("long_liquidation_usd_24h")
  shortLiquidationUsd24h  Float?   @map("short_liquidation_usd_24h")
  liquidationCount24h     Int?     @map("liquidation_count_24h")
  venueCount              Int      @map("venue_count")

  @@unique([symbol, capturedAt])
  @@index([symbol, capturedAt])
  @@map("asset_snapshot")
}

/// One contract on one venue at one moment.
model VenueSnapshot {
  id                     Int      @id @default(autoincrement())
  symbol                 String
  exchange               String
  /// The venue's own contract id, or its display symbol when it has none — a
  /// plain string rather than a nullable one, so the unique key never sees a
  /// NULL (which Postgres treats as distinct from every other NULL).
  instrument             String
  capturedAt             DateTime @map("captured_at")
  perpetual              Boolean
  openInterestUsd        Float    @map("open_interest_usd")
  openInterestAmount     Float?   @map("open_interest_amount")
  openInterestChange24h  Float?   @map("open_interest_change_24h")
  volumeUsd24h           Float?   @map("volume_usd_24h")
  fundingRate            Float?   @map("funding_rate")
  fundingIntervalHours   Int?     @map("funding_interval_hours")
  longRate               Float?   @map("long_rate")
  shortRate              Float?   @map("short_rate")
  longLiquidationUsd24h  Float?   @map("long_liquidation_usd_24h")
  shortLiquidationUsd24h Float?   @map("short_liquidation_usd_24h")
  price                  Float?

  @@unique([symbol, exchange, instrument, capturedAt])
  @@index([symbol, capturedAt])
  @@index([exchange, capturedAt])
  @@map("venue_snapshot")
}

/// The whole futures market at one moment.
model MarketSnapshot {
  id                    Int      @id @default(autoincrement())
  capturedAt            DateTime @unique @map("captured_at")
  openInterestUsd       Float?   @map("open_interest_usd")
  openInterestChange24h Float?   @map("open_interest_change_24h")
  liquidationUsd24h     Float?   @map("liquidation_usd_24h")
  liquidationChange24h  Float?   @map("liquidation_change_24h")
  tradersLiquidated24h  Int?     @map("traders_liquidated_24h")
  averageRsi            Float?   @map("average_rsi")
  coinsTracked          Int      @map("coins_tracked")

  @@index([capturedAt])
  @@map("market_snapshot")
}

/// A screener row kept over time, so the market can be read coin by coin.
model CoinSnapshot {
  id                     Int      @id @default(autoincrement())
  symbol                 String
  capturedAt             DateTime @map("captured_at")
  price                  Float?
  priceChangePercent24h  Float?   @map("price_change_percent_24h")
  openInterestUsd        Float?   @map("open_interest_usd")
  openInterestChange24h  Float?   @map("open_interest_change_24h")
  volumeUsd24h           Float?   @map("volume_usd_24h")
  fundingByOpenInterest  Float?   @map("funding_by_open_interest")
  fundingAnnualized      Float?   @map("funding_annualized")
  longShortRatio24h      Float?   @map("long_short_ratio_24h")
  liquidationUsd24h      Float?   @map("liquidation_usd_24h")
  marketCap              Float?   @map("market_cap")

  @@unique([symbol, capturedAt])
  @@index([capturedAt])
  @@map("coin_snapshot")
}

/// A funding interval. CoinGlass serves a fixed tail of history per scrape, so
/// the archive grows by whatever the newest scrape added and nothing else.
model FundingPoint {
  symbol     String
  at         DateTime
  open       Float
  high       Float
  low        Float
  close      Float
  priceOpen  Float?   @map("price_open")
  priceClose Float?   @map("price_close")

  @@id([symbol, at])
  @@index([symbol, at])
  @@map("funding_point")
}

/// A price point from the coin page's own series.
model PricePoint {
  symbol    String
  at        DateTime
  price     Float
  marketCap Float?   @map("market_cap")

  @@id([symbol, at])
  @@index([symbol, at])
  @@map("price_point")
}

/// A single liquidated position from the live feed.
model LiquidationOrder {
  /// CoinGlass ships no id on the feed rows, so identity is the order itself:
  /// venue, contract, instant and size. A re-scrape of an overlapping window
  /// therefore re-inserts nothing.
  id           String   @id
  exchange     String
  symbol       String
  instrumentId String?  @map("instrument_id")
  side         String?
  price        Float?
  quantity     Float?
  usd          Float
  at           DateTime

  @@index([at])
  @@index([symbol, at])
  @@index([exchange, at])
  @@map("liquidation_order")
}

// ---------------------------------------------------------------------------
// The agent workspace.
//
// Three separate concerns share this section, and keeping them separate is the
// point:
//
//  1. `agent_conversation` / `agent_message` / `agent_reference` are what the
//     UI renders — a turn, its citations, the tool activity behind it.
//  2. `agent_session_item` is what the model replays. The Agents SDK session
//     protocol is a flat list of input items (messages, function calls, their
//     outputs) and does not map onto "a message" one-for-one, so it gets its
//     own append-only table rather than being squeezed into the UI shape.
//  3. `agent_run` is telemetry: one row per run, written once it settles.
//
// Secrets live in `agent_secret`, encrypted; nothing else in the schema stores
// credential material.

/// A stored agent conversation.
model AgentConversation {
  id         String   @id
  /// The principal that owns it. Every read is scoped by this.
  userId     String   @map("user_id")
  title      String
  agentId    String   @map("agent_id")
  pinned     Boolean  @default(false)
  /// The chart/workspace the conversation was opened from.
  symbol     String?
  timeframe  String?
  workspace  String?
  providerId String?  @map("provider_id")
  modelId    String?  @map("model_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  messages     AgentMessage[]
  sessionItems AgentSessionItem[]
  runs         AgentRun[]

  @@index([userId, updatedAt])
  @@index([userId, pinned, updatedAt])
  @@map("agent_conversation")
}

/// One rendered turn.
model AgentMessage {
  id             String   @id
  conversationId String   @map("conversation_id")
  role           String
  text           String
  agentId        String?  @map("agent_id")
  providerId     String?  @map("provider_id")
  modelId        String?  @map("model_id")
  /// Context chips attached to a user turn.
  attachments    Json?
  /// Tool activity behind an assistant turn, already summarised for display.
  toolRuns       Json?    @map("tool_runs")
  /// A normalized error, when the turn failed.
  error          Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AgentConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  references   AgentMessageReference[]

  @@index([conversationId, createdAt])
  @@map("agent_message")
}

/// A citable source, of any kind, stored once and referenced many times.
model AgentReference {
  /// Derived from type + identity, so the same article cited twice is one row.
  id          String    @id
  type        String
  title       String
  url         String?
  source      String?
  publishedAt DateTime? @map("published_at")
  /// The internal id when this points at something we store, e.g. a news item.
  entityId    String?   @map("entity_id")
  snippet     String?
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  messages AgentMessageReference[]

  @@index([type, entityId])
  @@map("agent_reference")
}

/// The join that makes "[2]" in an answer resolve to a real source.
model AgentMessageReference {
  messageId     String @map("message_id")
  referenceId   String @map("reference_id")
  citationIndex Int    @map("citation_index")

  message   AgentMessage   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reference AgentReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@id([messageId, referenceId])
  @@index([messageId, citationIndex])
  @@map("agent_message_reference")
}

/// The Agents SDK session history, append-only and replayed in id order.
model AgentSessionItem {
  id             Int      @id @default(autoincrement())
  conversationId String   @map("conversation_id")
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, id])
  @@map("agent_session_item")
}

/// One run, for the run inspector and for provider/latency reporting.
model AgentRun {
  id             String    @id
  conversationId String    @map("conversation_id")
  userId         String    @map("user_id")
  agentId        String    @map("agent_id")
  status         String
  startedAt      DateTime  @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  durationMs     Int?      @map("duration_ms")
  /// Time to the first streamed token — the number users actually feel.
  firstTokenMs   Int?      @map("first_token_ms")
  providerId     String?   @map("provider_id")
  modelId        String?   @map("model_id")
  /// Set when the run started on one model and finished on another.
  fallbackFrom   String?   @map("fallback_from")
  inputTokens    Int       @default(0) @map("input_tokens")
  outputTokens   Int       @default(0) @map("output_tokens")
  requests       Int       @default(0)
  toolCalls      Int       @default(0) @map("tool_calls")
  toolFailures   Int       @default(0) @map("tool_failures")
  handoffs       Int       @default(0)
  searchProvider String?   @map("search_provider")
  referenceCount Int       @default(0) @map("reference_count")
  errorCode      String?   @map("error_code")

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([conversationId, startedAt])
  @@map("agent_run")
}

/// Provider and search credentials, encrypted with AES-256-GCM at rest.
model AgentSecret {
  key        String   @id
  ciphertext String
  iv         String
  tag        String
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("agent_secret")
}

/// Non-secret application settings, as one JSON document per key.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_setting")
}

/// A registered client, and the identity every agent request is scoped by.
model AgentDevice {
  id        String   @id
  userId    String   @map("user_id")
  label     String?
  platform  String?
  createdAt DateTime @default(now()) @map("created_at")
  lastSeen  DateTime @updatedAt @map("last_seen")

  @@index([userId])
  @@map("agent_device")
}

/// A canonical news item: one row per story, whatever provider it arrived from.
model NewsItem {
  /// Stable and internal (`news_…`), so an agent can cite it by id forever.
  id             String   @id
  title          String
  summary        String?
  /// Extracted article text when we have it. Untrusted input, never a prompt.
  body           String?
  source         String
  sourceUrl      String?  @map("source_url")
  canonicalUrl   String?  @map("canonical_url")
  publishedAt    DateTime @map("published_at")
  receivedAt     DateTime @default(now()) @map("received_at")
  symbols        String[]
  categories     String[]
  importance     String
  sentiment      String?
  provider       String
  providerItemId String?  @map("provider_item_id")
  metadata       Json?

  @@unique([provider, providerItemId])
  @@index([publishedAt])
  @@index([provider, publishedAt])
  @@map("news_item")
}
