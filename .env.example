# Base URL of the NestJS calendar service in server/.
# Defaults to http://localhost:4000 (http://10.0.2.2:4000 on the Android emulator).
# A physical device needs your machine's LAN address.
EXPO_PUBLIC_CALENDAR_API_URL=http://localhost:4000

# Matches AGENT_REGISTRATION_SECRET on the service, when it is set. A build
# without it cannot register with a gated service. It is a deployment gate, not
# a user credential: what authorizes requests is the token registration returns.
# EXPO_PUBLIC_AGENT_REGISTRATION_SECRET=
