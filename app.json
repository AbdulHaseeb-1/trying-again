{
  "expo": {
    "name": "MarketPulse",
    "slug": "try-again",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/marketpulse-icon.png",
    "scheme": "tryingagain",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/marketpulse-icon.png"
    },
    "android": {
      "package": "com.marketpulse.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/images/marketpulse-splash.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/marketpulse-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/images/marketpulse-splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/images/marketpulse-splash.png",
            "backgroundColor": "#0B0B0C"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "04228565-1f48-4a17-bbf6-50edff84ba8c"
      }
    },
    "owner": "abdulhaseeb600s-organization",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/04228565-1f48-4a17-bbf6-50edff84ba8c"
    }
  }
}
